# QUAERO Environment Variables
# Works without any keys — add these for better results

# Search providers (all free tiers available)
BRAVE_API_KEY=           # brave.com/search/api — 2000 free/month
TAVILY_API_KEY=          # tavily.com — 1000 free/month
EXA_API_KEY=             # exa.ai — 1000 free/month

# Model routing — defaults to OmniRoute (free models)
# OmniRoute must be running: omniroute (starts on port 20128)
OPENAI_BASE_URL=http://localhost:20128/v1
OPENAI_API_KEY=omniroute

# Or use Anthropic directly
# OPENAI_BASE_URL=https://api.anthropic.com/v1
# OPENAI_API_KEY=sk-ant-...

# MiroFish swarm prediction
MIROFISH_ENABLED=true
MIROFISH_AGENTS=500

# Storage (auto-started via docker compose)
REDIS_URL=redis://localhost:6379
QDRANT_URL=http://localhost:6333
